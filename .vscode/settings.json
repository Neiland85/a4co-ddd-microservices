{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  "eslint.validate": ["typescript", "javascript"],
  "eslint.workingDirectories": [
    { "directory": "apps/infrastructure/gateway", "changeProcessCWD": true },
    { "directory": "apps/services/order-service", "changeProcessCWD": true },
    { "directory": "apps/services/inventory-service", "changeProcessCWD": true },
    { "directory": "packages/shared-utils", "changeProcessCWD": true },
    { "directory": "packages/shared-events", "changeProcessCWD": true },
    { "directory": "packages/observability", "changeProcessCWD": true }
  ],

  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.wordWrap": "on",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },

  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": ["**/package.json"]
    }
  ],

  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.DS_Store": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.turbo": true,
    "**/.next": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.turbo": true,
    "**/.next": true,
    "**/pnpm-lock.yaml": true
  },

  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true,
    "**/.next/**": true
  },

  "cSpell.language": "en,es",
  "cSpell.words": [
    "a4co",
    "CQRS",
    "DDD",
    "Fastify",
    "Grafana",
    "Jaeger",
    "JetStream",
    "Loki",
    "NATS",
    "NestJS",
    "PostgreSQL",
    "Prisma",
    "Prometheus",
    "Sagas",
    "TypeScript"
  ],

  "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
  "terminal.integrated.inheritEnv": true,

  "telemetry.telemetryLevel": "off",

  "prisma.pinToPrisma6": true,

  "github.copilot.chat.generateTests.codeLens": false,
  "github.copilot.chat.codesearch.enabled": true
}
