{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": "../../..",
    "paths": {
      "@a4co/shared-utils": ["packages/shared-utils/dist/index"],
      "@a4co/shared-utils/*": ["packages/shared-utils/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
